{
  "name": "@goodai/assessment-mcp",
  "version": "0.1.0",
  "description": "Enterprise AI Assessment MCP Server - Leverage, not lore",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "assessment-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-assessment",
    "enterprise",
    "good-ai"
  ],
  "author": "Good AI <contact@wearegoodai.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodAI-Global/assessment-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/GoodAI-Global/assessment-mcp/issues"
  },
  "homepage": "https://github.com/GoodAI-Global/assessment-mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.1.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.51.0"
  }
}
